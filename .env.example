# /opt/kuzya-admin/.env (chmod 600). Значения — только на сервере, в git не идут. DATABASE_URL — из /root/pg-secrets/kuzya.env.
MAX_KUZYA_BOT_TOKEN=         # тот же бот, что у kuzya-web
SESSION_SECRET=              # openssl rand -hex 32
ADMIN_NOTIFY_UID=            # Max uid, кому уходят ссылки установки пароля (Вадим)
MONITOR_CHAT_ID=             # «Мониторинг КУЗЯ» — зеркало ответов операторов
BROADCAST_ENABLED=0          # 1 — боевые рассылки (только по решению Вадима)
TRAEFIK_ENABLE=false
# PUBLIC_URL=https://adminkuzya.velcom-holding.ru   # для показа через туннель: http://localhost:8083
# COOKIE_SECURE=1
